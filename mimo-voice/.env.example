# MiMo Voice — Configuration
# Copy to .env and fill in your API key

# MiMo API Key (required)
# Register at: https://platform.xiaomimimo.com
MIMO_API_KEY=your_api_key_here

# API Base URL
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Default languages
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=ja

# Models
TRANSLATION_MODEL=mimo-v2.5-pro
TTS_MODEL=mimo-v2-tts
OMNI_MODEL=mimo-v2.5-omni

# Context detection
AUTO_DETECT_CONTEXT=true
DEFAULT_SITUATION=general

# Performance
TRANSLATION_TIMEOUT=30
TTS_TIMEOUT=15

# Camera mode
ENABLE_CAMERA=true

# User allergens (comma-separated)
USER_ALLERGENS=
